# ─── Required ───────────────────────────────────────────────────────────────
# The default answer model, and DeepEval's judge during evaluation.
OPENAI_API_KEY=

# ─── Optional providers ─────────────────────────────────────────────────────
# Enables the low-confidence web-search fallback.
SERPER_API_KEY=
# Add answer models to the UI's picker.
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Backends ───────────────────────────────────────────────────────────────
# Unset  -> embedded on-disk Qdrant; one process only (local development).
# Set    -> Qdrant server; many clients, required for more than one replica.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# QDRANT_PATH=./qdrant_data

# Unset  -> SQLite file; ties sessions to one machine's disk.
# Set    -> Postgres; required for more than one API replica.
# DATABASE_URL=postgresql://laws:laws@postgres:5432/laws
# DATABASE_PATH=./indian_laws_memory.db

# ─── API surface ────────────────────────────────────────────────────────────
# Unset -> the API is open. Set -> requests need an X-API-Key header.
# API_KEY=
# CORS_ORIGINS=https://laws.example.com
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_ENABLED=true

# ─── Observability ──────────────────────────────────────────────────────────
# LOG_FORMAT=json            # "text" locally, "json" in a deployment
# LOG_LEVEL=INFO
# SERVICE_NAME=indian-laws-rag

# ─── Model behaviour ────────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# WARMUP_ON_STARTUP=true     # load models at startup, not on the first request

# Model overrides, per provider and purpose.
# Utility = query rewriting and decomposition; Answer = the cited legal answer.
# OPENAI_UTILITY_MODEL=gpt-4.1-nano
# OPENAI_ANSWER_MODEL=gpt-4.1-mini
# GROQ_UTILITY_MODEL=llama-3.1-8b-instant
# GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
# GEMINI_UTILITY_MODEL=gemini-2.5-flash-lite
# GEMINI_ANSWER_MODEL=gemini-2.5-flash

# ─── Retrieval tuning (defaults shown) ──────────────────────────────────────
# FUSED_K=25
# MMR_K=15
# MMR_LAMBDA=0.5
# RERANK_TOP_N=6
# CONFIDENCE_THRESHOLD=0.35
# MAX_SUB_QUERIES=3
# HISTORY_TURNS=4

# ─── Compose only ───────────────────────────────────────────────────────────
# POSTGRES_USER=laws
# POSTGRES_PASSWORD=laws
# POSTGRES_DB=laws
